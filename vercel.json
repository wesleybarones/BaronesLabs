{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "^/$",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(WhatsApp|facebookexternalhit|Facebot|TelegramBot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Pinterest).*"
        }
      ],
      "dest": "/og.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/portfolio/?$",
      "dest": "/index.html"
    },
    {
      "handle": "error"
    },
    {
      "status": 404,
      "src": "/(.*)",
      "dest": "/404.html"
    }
  ]
}
